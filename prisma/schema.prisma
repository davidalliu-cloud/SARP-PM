generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  NOT_STARTED
  ACTIVE
  ON_HOLD
  FINISHED
}

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum OfferType {
  WORKS
  PRODUCTS
}

// DRAFT -> (non-admin) PENDING_APPROVAL -> READY -> SENT -> WON | LOST.
// Admin-created offers skip PENDING_APPROVAL. WON creates the project.
enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  READY
  SENT
  WON
  LOST
  CANCELLED
}

model User {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  passwordHash   String
  role           UserRole     @default(EMPLOYEE)
  sessions       Session[]
  offersCreated  Offer[]      @relation("OfferCreatedBy")
  offersApproved Offer[]      @relation("OfferApprovedBy")
  offerEvents    OfferEvent[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Session {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model Project {
  id           String        @id @default(cuid())
  name         String
  clientName   String?
  startDate    DateTime
  status       ProjectStatus @default(NOT_STARTED)
  budgetAmount Float         @default(0)
  estimatedContractValue Float @default(0)
  estimatedProfitMargin Float @default(0)
  contractAreaM2 Float        @default(0)
  dailyRecords DailyRecord[]
  invoices     Invoice[]
  attachments  Attachment[]
  offer        Offer?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Offer {
  id             String         @id @default(cuid())
  code           String         @unique
  type           OfferType      @default(WORKS)
  status         OfferStatus    @default(DRAFT)
  clientName     String
  projectName    String
  siteAddress    String?
  issueDate      DateTime
  validUntil     DateTime
  currency       String         @default("EUR")
  // ALL per 1 EUR; used to convert ALL offers into the EUR project values.
  exchangeRate   Float          @default(100)
  vatRate        Float          @default(20)
  discountPct    Float          @default(0)
  paymentTerms   String?
  executionTerms String?
  warrantyTerms  String?
  exclusions     String?
  internalNotes  String?
  reviewComment  String?
  lostReason     String?
  createdById    String
  createdBy      User           @relation("OfferCreatedBy", fields: [createdById], references: [id])
  approvedById   String?
  approvedBy     User?          @relation("OfferApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  sentAt         DateTime?
  decidedAt      DateTime?
  projectId      String?        @unique
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sections       OfferSection[]
  events         OfferEvent[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

// A section is one system/zone. With areaM2 set, item quantities are
// consumption per m2 and the section total is (value per m2) x areaM2.
// Without areaM2, item quantities are absolute (product offers).
model OfferSection {
  id          String      @id @default(cuid())
  offerId     String
  offer       Offer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  sortOrder   Int         @default(0)
  title       String
  zone        String?
  description String?
  areaM2      Float?
  isOption    Boolean     @default(false)
  items       OfferItem[]
}

model OfferItem {
  id          String       @id @default(cuid())
  sectionId   String
  section     OfferSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sortOrder   Int          @default(0)
  kind        String       @default("MATERIAL")
  description String
  productName String?
  unit        String
  quantity    Float
  unitPrice   Float
  unitCost    Float        @default(0)
}

model OfferEvent {
  id        String   @id @default(cuid())
  offerId   String
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  comment   String?
  createdAt DateTime @default(now())
}

model Product {
  id                 String             @id @default(cuid())
  name               String
  unit               String
  defaultCostPerUnit Float
  // Waterproofing offer costing (from the SARP catalogue / Mapei TDS). Kept
  // separate from unit/defaultCostPerUnit so daily-record semantics are untouched.
  consumptionPerM2   Float? // base units of this product used per 1 m² of system
  consumptionBasis   String? // how the consumption was derived / TDS source note
  workItem           String? // "Zëri i Punës" — the work-item description for offers
  baseUnit           String? // offer base unit the consumption/price refer to (m2, kg, litër…)
  supplierPriceAll   Float? // supplier price per base unit, ALL (the "P" in the costing engine)
  priceEur           Float? // supplier price per base unit, EUR (reference)
  usageItems         ProductUsageItem[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Employee {
  id               String              @id @default(cuid())
  name             String
  role             String?
  defaultDailyWage Float
  labourItems      LabourEntryItem[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model ExpenseType {
  id            String        @id @default(cuid())
  name          String
  defaultAmount Float         @default(0)
  notes         String?
  expenseItems  ExpenseItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model DailyRecord {
  id           String             @id @default(cuid())
  projectId    String
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date         DateTime
  completedAreaM2 Float       @default(0)
  clientName   String?
  notes        String?
  productItems ProductUsageItem[]
  labourItems  LabourEntryItem[]
  expenseItems ExpenseItem[]
  attachments  Attachment[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model ProductUsageItem {
  id            String      @id @default(cuid())
  dailyRecordId String
  dailyRecord   DailyRecord @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Float
  costPerUnit   Float
}

model LabourEntryItem {
  id                 String      @id @default(cuid())
  dailyRecordId      String
  dailyRecord        DailyRecord @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)
  employeeId         String?
  employee           Employee?   @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeName       String?
  externalTeamName   String?
  ratePerSquareMeter Float?
  squareMeters       Float?
  dailyWage          Float
}

model ExpenseItem {
  id            String       @id @default(cuid())
  dailyRecordId String
  dailyRecord   DailyRecord  @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)
  expenseTypeId String?
  expenseType   ExpenseType? @relation(fields: [expenseTypeId], references: [id])
  category      String
  description   String?
  amount        Float
}

model Invoice {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceDate  DateTime
  monthCovered String
  invoiceNo    String?
  amount       Float
  sourceAmount   Float?
  sourceCurrency String?
  vatRate        Float?
  dueDate      DateTime?
  isPaid       Boolean  @default(false)
  paidDate     DateTime?
  clientName   String?
  notes        String?
  attachments  Attachment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Attachment {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dailyRecordId String?
  dailyRecord   DailyRecord? @relation(fields: [dailyRecordId], references: [id], onDelete: SetNull)
  invoiceId     String?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  category      String
  label         String?
  fileName      String
  contentType   String
  size          Int
  data          Bytes
  createdAt     DateTime     @default(now())
}
